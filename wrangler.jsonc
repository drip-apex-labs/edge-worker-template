{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apex-edge-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-08-04",
  "vars": {
    "SHOP_ID": "",
    "ORIGIN_URL": "",
    "CONFIG_API_URL": "",
    "CONFIG_CACHE_MODE": "kv"
  },
  "kv_namespaces": [
    {
      "binding": "APEX_EDGE_CACHE"
    }
  ]
}
